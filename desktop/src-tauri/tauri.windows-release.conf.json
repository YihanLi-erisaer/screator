{
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "StarDazz",
    "resources": {
      "../../packaging/staging/screator-worker/": "worker/",
      "../../packaging/staging/windows-bin/": "bin/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "languages": ["SimpChinese", "TradChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "StarDazz",
        "installerHooks": "../../packaging/windows-installer-hooks.nsh"
      }
    }
  }
}
