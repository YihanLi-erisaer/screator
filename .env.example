# Local translation is the default; DeepL is an optional fallback.
TRANSLATION_PRIMARY=local_llm
TRANSLATION_FALLBACK_ENABLED=true
LOCAL_LLM_MODE=managed
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435
LOCAL_LLM_MODEL=qwen3.5:4b
# auto enables Vulkan/integrated GPUs for the managed Windows runtime while
# retaining native NVIDIA/AMD discovery; vulkan selects that backend, cpu disables GPU offload.
LOCAL_LLM_BACKEND=auto
# Advanced managed-runtime opt-outs / device selection (also set these on an external server):
# OLLAMA_VULKAN=0
# OLLAMA_IGPU_ENABLE=0
# GGML_VK_VISIBLE_DEVICES=1
# For your own local Ollama: use external mode and port 11434.
# Set TRANSLATION_FALLBACK_ENABLED=false to keep all translation local.
# Optional DeepL API key. Do not commit the real key.
DEEPL_AUTH_KEY=

# Optional: override paths
# BILIUP_BIN=C:\path\to\biliup.exe
# BILI_COOKIES=secrets/bili_cookies.json
# YOUTUBE_COOKIES=secrets/youtube_cookies.txt
# Or read cookies from a logged-in browser (close it first): chrome / edge / firefox
# YOUTUBE_COOKIES_FROM_BROWSER=edge

# Bilibili defaults (biliup default partition = 171 知识·野生技术协会)
# BILI_TID=171
# BILI_TAGS=转载
# Upload CDN line (tx / bda2 / qn / ws). Avoid bldsa on Windows.
BILI_LINE=tx

# Download, validation/preparation and upload queues each have one worker.
# Legacy DOWNLOAD_JOBS / -j options no longer increase stage concurrency.
# Seconds to wait between uploads (rate-limit friendly).
# UPLOAD_GAP_SECONDS=20

# Full media validation: Windows D3D11VA (Intel/AMD/NVIDIA), Linux CUDA/VAAPI,
# macOS VideoToolbox. Failed hardware attempts restart from the beginning; CPU is last.
# Set cpu to disable hardware decoding.
# Other choices: cuda / d3d11va / vaapi / videotoolbox.
# SCREATOR_HWACCEL=auto
# Optional D3D11 adapter index or Linux VAAPI render node; CUDA index in cuda mode.
# SCREATOR_HWACCEL_DEVICE=/dev/dri/renderD129
# Persistent validation cache (full SHA-256 checked on every reuse).
# Set 0 to force a full decode even when an unchanged file was validated before.
# SCREATOR_VALIDATION_CACHE=1
